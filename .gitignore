# Python 虚拟环境（180MB）
.venv/

# 编辑器配置
.idea/
.vscode/

# Python 缓存
__pycache__/
*.py[cod]

# 运行日志（text1.py 每次跑都会往这里追加）
logs/

# adb 工具（17MB）。按 README「环境」一节自己下载
tools/

# 截图一律不传 —— 里面是手机全屏画面（状态栏、桌面），
# 只留 5 个手工切出来的模板，它们才是脚本真正依赖的输入。
images/*
!images/play_btn.png
!images/done.png
!images/tab_undone.png
!images/chip_video.png
!images/template.png

# 电脑版（yuketang.cn）的模板，同样只留模板不留截图
# 现在真正在用的是下面 4 张；list_todo / done_txt 是上一版留下的，已经用不上了
images_pc/*
!images_pc/tag_video.png
!images_pc/done_all.png
!images_pc/next_arrow.png
!images_pc/play_bar.png
